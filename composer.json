    {
      "name": "Philipp Michaelis",
      "homepage": "https://github.com/pmichaelis"
    }
  ],
  "require": {
    "php": ">=8.1",
    "maxmind-db/reader": "^1.12"
  },
  "config": {
    "optimize-autoloader": true
  }
